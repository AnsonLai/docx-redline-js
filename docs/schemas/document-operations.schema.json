{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AnsonLai/docx-redline-js/docs/schemas/document-operations.schema.json",
  "title": "docx-redline document operations",
  "oneOf": [
    { "$ref": "#/$defs/operationArray" },
    {
      "type": "object",
      "required": ["operations"],
      "properties": {
        "operations": { "$ref": "#/$defs/operationArray" },
        "expectedRevision": { "$ref": "#/$defs/revisionToken" }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "revisionToken": {
      "type": "object",
      "required": ["algorithm", "version", "scope", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["sha256"] },
        "version": { "type": "integer", "enum": [1] },
        "scope": { "type": "string", "enum": ["document-parts", "package"] },
        "value": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "coveredParts": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "operationArray": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "target": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "properties": {
            "exactText": { "type": "string" }, "text": { "type": "string" },
            "index": { "type": ["integer", "string"] }, "paragraphIndex": { "type": ["integer", "string"] },
            "paragraphId": { "type": "string" }, "occurrence": { "type": "integer", "minimum": 1 },
            "inTable": { "type": "boolean" }, "fingerprint": { "type": "string" }, "sourceFingerprint": { "type": "string" },
            "revisionView": { "type": "string", "enum": ["accepted", "rejected"] },
            "captureRef": { "type": "string", "minLength": 1, "maxLength": 256 },
            "select": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false,
          "anyOf": [ { "required": ["exactText"] }, { "required": ["text"] }, { "required": ["index"] }, { "required": ["paragraphIndex"] }, { "required": ["paragraphId"] }, { "required": ["fingerprint"] }, { "required": ["sourceFingerprint"] }, { "required": ["captureRef"] } ]
        }
      ]
    },
    "base": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "captureKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target": { "$ref": "#/$defs/target" }, "targetRef": { "type": ["integer", "string", "null"] },
        "author": { "type": "string", "minLength": 1 }, "generateRedlines": { "type": "boolean" },
        "existingRevisions": { "enum": ["merge-same-author", "reject-input", "accept-all-first", "accept-all-first-keep-normalized"] },
        "pairReplacements": { "type": "boolean" },
        "insertionAffinity": {
          "type": "object",
          "properties": {
            "formatting": { "enum": ["left", "right", "none"] },
            "hyperlink": { "enum": ["inside", "outside", "preserve"] },
            "revision": { "enum": ["coalesce_same_author", "separate"] },
            "bookmark": { "enum": ["inside", "outside"] },
            "comment": { "enum": ["inside", "outside"] }
          },
          "additionalProperties": false
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "parentCommentId", "commentContent"],
          "properties": {
            "type": { "const": "comment_reply" },
            "operationId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "parentCommentId": { "type": ["integer", "string"] },
            "commentContent": { "type": "string", "minLength": 1 },
            "author": { "type": "string", "minLength": 1 },
            "date": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        {
          "allOf": [ { "$ref": "#/$defs/base" }, { "type": "object", "required": ["modified"], "properties": { "type": { "enum": ["redline", "replace", "format", "list-change", "table-reconciliation", "insert"] }, "modified": { "type": "string" }, "structuredContent": { "type": "boolean" }, "targetEnd": { "$ref": "#/$defs/target" }, "targetEndRef": { "type": ["integer", "string", "null"] } } } ]
        },
        {
          "allOf": [ { "$ref": "#/$defs/base" }, { "type": "object", "properties": { "type": { "const": "delete" }, "modified": { "const": "" } } } ]
        },
        {
          "allOf": [ { "$ref": "#/$defs/base" }, { "type": "object", "required": ["commentContent"], "properties": { "type": { "const": "comment" }, "textToComment": { "type": "string" }, "commentContent": { "type": "string", "minLength": 1 } } } ]
        },
        {
          "allOf": [ { "$ref": "#/$defs/base" }, { "type": "object", "required": ["textToHighlight"], "properties": { "type": { "const": "highlight" }, "textToHighlight": { "type": "string", "minLength": 1 }, "color": { "type": "string" } } } ]
        },
        {
          "allOf": [ { "$ref": "#/$defs/base" }, { "type": "object", "required": ["textToFormat", "properties"], "properties": { "type": { "enum": ["format", "character-format"] }, "textToFormat": { "type": "string", "minLength": 1 }, "properties": { "type": "object" }, "formattingRevisionPolicy": { "enum": ["always", "coalesce-own-insertion"] } } } ]
        },
        {
          "allOf": [ { "$ref": "#/$defs/base" }, { "type": "object", "required": ["properties"], "properties": { "type": { "const": "paragraph-format" }, "properties": { "type": "object" } } } ]
        }
      ]
    }
  }
}
